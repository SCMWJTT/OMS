{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://oms.cynmark.app/schemas/one-prs-2.schema.json",
 "title": "ONE process model file (ONE-PRS/2)",
 "description": "ONE-PRS/1 plus the links and data ONE needs to show a process working: lane roles and functions, typed flows (information, material, people), cycles, policy commitments, value model, revision history and the ledger it is measured by. A ONE-PRS/1 file is read unchanged.",
 "type": "object",
 "required": [
  "schema",
  "id",
  "revision",
  "status",
  "title",
  "apqc",
  "owner",
  "function",
  "policy",
  "parent",
  "oms_tags",
  "lanes",
  "steps",
  "kpis"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "enum": [
    "ONE-PRS/1",
    "ONE-PRS/2"
   ]
  },
  "id": {
   "type": "string",
   "pattern": "^ACE-[A-Z]{3}-PRS-\\d{3}(-[A-Z]{3})?$"
  },
  "revision": {
   "type": "string",
   "pattern": "^([A-Z]|\\d{2})$"
  },
  "status": {
   "enum": [
    "Draft",
    "In Review",
    "Approved",
    "Superseded",
    "Withdrawn"
   ]
  },
  "title": {
   "type": "string",
   "minLength": 3
  },
  "apqc": {
   "type": "object",
   "required": [
    "l1",
    "l2",
    "l3"
   ],
   "additionalProperties": false,
   "properties": {
    "l1": {
     "type": "string",
     "description": "L1 code and name, e.g. '7 Manage Risk & HSE'"
    },
    "l2": {
     "type": "string",
     "description": "L2 code and name, e.g. '7.2 Manage change'"
    },
    "l3": {
     "type": "string",
     "description": "This process's title"
    }
   }
  },
  "owner": {
   "type": "string",
   "pattern": "^.+ — .+$",
   "description": "Name — Job title, as in ACE_People.csv"
  },
  "function": {
   "type": "string"
  },
  "policy": {
   "type": "string",
   "pattern": "^ACE-[A-Z]{3}-POL-\\d{3}$"
  },
  "parent": {
   "type": "string",
   "pattern": "^ACE-[A-Z]{3}-[A-Z]{3}-\\d{3}(-[A-Z]{3})?$"
  },
  "oms_tags": {
   "type": "array",
   "minItems": 1,
   "maxItems": 3,
   "items": {
    "type": "string",
    "pattern": "^(10|[1-9])\\.[1-9]$"
   }
  },
  "sipoc": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "suppliers": {
     "$ref": "#/$defs/strs"
    },
    "inputs": {
     "$ref": "#/$defs/strs"
    },
    "process": {
     "$ref": "#/$defs/strs"
    },
    "outputs": {
     "$ref": "#/$defs/strs"
    },
    "customers": {
     "$ref": "#/$defs/strs"
    }
   }
  },
  "lanes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "role"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^L\\d+$"
     },
     "role": {
      "type": "string"
     },
     "role_id": {
      "type": "string"
     },
     "function": {
      "type": "string",
      "description": "Function code from company/org/functions.csv, or CTR for a contractor"
     },
     "oms_role": {
      "type": "string"
     },
     "external": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "steps": {
   "type": "array",
   "minItems": 6,
   "maxItems": 30,
   "items": {
    "$ref": "#/$defs/step"
   }
  },
  "kpis": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "target",
     "type"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "target": {
      "type": "string"
     },
     "type": {
      "enum": [
       "leading",
       "lagging"
      ]
     },
     "family": {
      "enum": [
       "cycle time",
       "quality",
       "control effectiveness",
       "conformance",
       "other"
      ]
     },
     "measure": {
      "type": "string"
     },
     "threshold": {
      "type": "number"
     },
     "better": {
      "enum": [
       "up",
       "down"
      ]
     }
    }
   }
  },
  "sim_defaults": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "volume_per_year": {
     "type": "number",
     "minimum": 0
    },
    "rates_per_h": {
     "type": "object",
     "additionalProperties": {
      "type": "number",
      "minimum": 0
     }
    }
   }
  },
  "summary": {
   "type": "string"
  },
  "character": {
   "enum": [
    "information",
    "material",
    "people",
    "cyclical",
    "mixed"
   ]
  },
  "commitments": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^ACE-[A-Z]{3}-POL-\\d{3}#[A-Z0-9_]+$"
   }
  },
  "policies_also": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^ACE-[A-Z]{3}-POL-\\d{3}$"
   }
  },
  "objectives": {
   "$ref": "#/$defs/strs"
  },
  "ledger": {
   "type": "string"
  },
  "case_label": {
   "type": "string"
  },
  "cycle": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "from",
    "to"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "from": {
     "$ref": "#/$defs/stepId"
    },
    "to": {
     "$ref": "#/$defs/stepId"
    },
    "label": {
     "type": "string"
    },
    "period": {
     "type": "string"
    }
   }
  },
  "flows": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "from",
     "to",
     "type"
    ],
    "properties": {
     "from": {
      "$ref": "#/$defs/stepId"
     },
     "to": {
      "type": "string",
      "description": "A step id, or another process number for a hand-off out of this process"
     },
     "type": {
      "enum": [
       "information",
       "material",
       "people"
      ]
     },
     "carries": {
      "type": "string"
     }
    }
   }
  },
  "value": {
   "type": "object",
   "properties": {
    "model": {
     "type": "string"
    },
    "explain": {
     "type": "string"
    }
   },
   "additionalProperties": true
  },
  "history": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "revision",
     "date",
     "summary"
    ],
    "properties": {
     "revision": {
      "type": "string"
     },
     "date": {
      "type": "string",
      "format": "date"
     },
     "summary": {
      "type": "string"
     },
     "ci": {
      "type": "string"
     },
     "changed_steps": {
      "$ref": "#/$defs/strs"
     }
    }
   }
  },
  "stages": {
   "type": "array",
   "description": "3 to 6 stages that group the steps; the map opens at this level",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "steps"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "icon": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[A-Za-z0-9_]+)+$",
      "description": "Icon registry key (standards/icons/one-icons.json)"
     },
     "element": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
     },
     "steps": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/stepId"
      }
     },
     "summary": {
      "type": "string"
     }
    }
   }
  },
  "artefacts": {
   "type": "array",
   "description": "Documents, records, data and systems the process touches",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "icon"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "icon": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[A-Za-z0-9_]+)+$",
      "description": "Icon registry key (standards/icons/one-icons.json)"
     },
     "system": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[A-Za-z0-9_]+)+$",
      "description": "Icon registry key (standards/icons/one-icons.json)"
     },
     "doc": {
      "type": "string"
     }
    }
   }
  },
  "capacity": {
   "type": "string"
  },
  "scenarios": {
   "type": "string"
  },
  "data_map": {
   "type": "string"
  }
 },
 "$defs": {
  "strs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "stepId": {
   "type": "string",
   "pattern": "^S\\d{2}$"
  },
  "step": {
   "type": "object",
   "required": [
    "id",
    "lane",
    "type",
    "name"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "$ref": "#/$defs/stepId"
    },
    "lane": {
     "type": "string",
     "pattern": "^L\\d+$"
    },
    "type": {
     "enum": [
      "start",
      "end",
      "task",
      "xor",
      "and",
      "wait"
     ]
    },
    "name": {
     "type": "string",
     "minLength": 3
    },
    "inputs": {
     "$ref": "#/$defs/strs"
    },
    "outputs": {
     "$ref": "#/$defs/strs"
    },
    "doc_refs": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^ACE-[A-Z]{3}-[A-Z]{3}-\\d{3}(-[A-Z]{3})?#[A-Za-z0-9_]+$"
     }
    },
    "controls": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^C-[A-Z]{3}-\\d{3}$"
     }
    },
    "records": {
     "$ref": "#/$defs/strs"
    },
    "systems": {
     "$ref": "#/$defs/strs"
    },
    "next": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/stepId"
     }
    },
    "branches": {
     "type": "array",
     "minItems": 2,
     "items": {
      "type": "object",
      "required": [
       "to",
       "label"
      ],
      "additionalProperties": false,
      "properties": {
       "to": {
        "$ref": "#/$defs/stepId"
       },
       "label": {
        "type": "string"
       },
       "p": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "loop": {
        "enum": [
         "rework",
         "cycle"
        ]
       }
      }
     }
    },
    "sim": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "dur_h": {
       "type": "array",
       "items": {
        "type": "number",
        "minimum": 0
       },
       "minItems": 3,
       "maxItems": 3
      },
      "wait_h": {
       "type": "number",
       "minimum": 0
      },
      "cost_role": {
       "type": "string",
       "pattern": "^L\\d+$"
      }
     }
    },
    "value": {
     "enum": [
      "VA",
      "BVA",
      "NVA"
     ],
     "description": "Value-added, business-value-added (needed but not valued by the customer) or non-value-added"
    },
    "commitment": {
     "type": "string"
    },
    "threshold": {
     "type": "string"
    },
    "site": {
     "type": "string"
    },
    "icon": {
     "type": "string",
     "pattern": "^[a-z]+(\\.[A-Za-z0-9_]+)+$",
     "description": "Icon registry key (standards/icons/one-icons.json)"
    },
    "element": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10
    },
    "target_days": {
     "type": "number",
     "minimum": 0
    },
    "touch": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "a",
       "op"
      ],
      "properties": {
       "a": {
        "type": "string"
       },
       "op": {
        "enum": [
         "C",
         "R",
         "U"
        ]
       }
      }
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "xor"
       }
      }
     },
     "then": {
      "required": [
       "branches"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "end"
       }
      }
     },
     "then": {
      "not": {
       "required": [
        "next"
       ]
      }
     },
     "else": {
      "anyOf": [
       {
        "required": [
         "next"
        ]
       },
       {
        "required": [
         "branches"
        ]
       }
      ]
     }
    }
   ]
  }
 }
}