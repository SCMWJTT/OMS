{
 "schema": "ONE-PRS/1",
 "id": "ACE-MOC-PRS-001",
 "revision": "A",
 "status": "Draft",
 "title": "Management of Change Process",
 "apqc": {"l1": "7 Manage Risk & HSE", "l2": "7.2 Manage change", "l3": "Management of Change Process"},
 "owner": "Elena Farfan — Manager, Technical Excellence",
 "function": "Engineering & Projects",
 "policy": "ACE-LDR-POL-001",
 "parent": "ACE-MOC-PRC-001",
 "oms_tags": ["5.3", "6.2", "7.1"],
 "sipoc": {
  "suppliers": ["Operations", "Engineering", "Wells", "Contractors"],
  "inputs": ["Proposed change", "Current documents and drawings", "Risk assessment"],
  "process": ["Raise", "Classify", "Assess", "Approve", "Implement", "Verify", "Close"],
  "outputs": ["Approved and implemented change", "Revised documents", "Training records", "Close-out record"],
  "customers": ["Area Authority", "Operators", "Maintenance", "Process owners"]
 },
 "lanes": [
  {"id": "L1", "role": "Change Originator"},
  {"id": "L2", "role": "MOC Coordinator"},
  {"id": "L3", "role": "Technical Authority"},
  {"id": "L4", "role": "Area Authority"},
  {"id": "L5", "role": "MOC Approver"}
 ],
 "steps": [
  {"id": "S01", "lane": "L1", "type": "start", "name": "Identify change", "next": ["S02"]},
  {"id": "S02", "lane": "L1", "type": "task", "name": "Raise MOC request",
   "inputs": ["Change description"], "outputs": ["MOC record"],
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H207"], "controls": ["C-OPS-009", "C-BPM-044"],
   "records": ["MOC register entry"], "systems": ["ONE MOC module"],
   "sim": {"dur_h": [0.5, 1, 3], "cost_role": "L1"}, "next": ["S03"]},
  {"id": "S03", "lane": "L2", "type": "xor", "name": "Classify change",
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H208"],
   "branches": [{"to": "S04", "label": "Major", "p": 0.3}, {"to": "S05", "label": "Minor", "p": 0.7}]},
  {"id": "S04", "lane": "L3", "type": "task", "name": "Assess technical risk",
   "inputs": ["MOC record"], "outputs": ["Risk assessment"],
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H211", "ACE-MOC-PRC-001#ACE_MOC_PRC_001_H212"],
   "records": ["Risk assessment"], "sim": {"dur_h": [4, 8, 24], "wait_h": 48, "cost_role": "L3"}, "next": ["S06"]},
  {"id": "S05", "lane": "L2", "type": "task", "name": "Screen minor change",
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H209"], "records": ["Screening record"],
   "sim": {"dur_h": [0.5, 1, 2], "cost_role": "L2"}, "next": ["S06"]},
  {"id": "S06", "lane": "L4", "type": "task", "name": "Review operational impact",
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H213"], "records": ["Impact review"],
   "sim": {"dur_h": [1, 2, 6], "wait_h": 24, "cost_role": "L4"}, "next": ["S07"]},
  {"id": "S07", "lane": "L5", "type": "xor", "name": "Approve change",
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H216"],
   "branches": [{"to": "S08", "label": "Approved", "p": 0.85}, {"to": "S12", "label": "Rejected", "p": 0.15}]},
  {"id": "S08", "lane": "L1", "type": "task", "name": "Implement change",
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H220"], "outputs": ["Work orders", "Updated documents"],
   "systems": ["CMMS"], "sim": {"dur_h": [8, 40, 200], "cost_role": "L1"}, "next": ["S09"]},
  {"id": "S09", "lane": "L4", "type": "task", "name": "Verify pre-start readiness",
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H224"], "records": ["PSSR record"],
   "sim": {"dur_h": [2, 4, 8], "cost_role": "L4"}, "next": ["S10"]},
  {"id": "S10", "lane": "L2", "type": "task", "name": "Update documents and train",
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H222"], "records": ["Revised documents", "Training record"],
   "controls": ["C-BPM-045"], "sim": {"dur_h": [2, 8, 24], "cost_role": "L2"}, "next": ["S11"]},
  {"id": "S11", "lane": "L2", "type": "end", "name": "Close MOC",
   "doc_refs": ["ACE-MOC-PRC-001#ACE_MOC_PRC_001_H232"], "records": ["Close-out record"]},
  {"id": "S12", "lane": "L1", "type": "end", "name": "Change rejected", "records": ["Rejection record"]}
 ],
 "kpis": [
  {"name": "MOC cycle time (median)", "target": "≤ 30 days", "type": "lagging", "family": "cycle time"},
  {"name": "MOCs approved without return", "target": "≥ 85%", "type": "leading", "family": "quality"},
  {"name": "Pre-start reviews completed before start-up", "target": "100%", "type": "leading", "family": "control effectiveness"},
  {"name": "Sampled MOCs fully compliant", "target": "≥ 90%", "type": "lagging", "family": "conformance"}
 ],
 "sim_defaults": {"volume_per_year": 120, "rates_per_h": {"L1": 60, "L2": 75, "L3": 120, "L4": 95, "L5": 140}}
}
