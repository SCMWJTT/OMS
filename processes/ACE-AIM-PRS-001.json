  "value": {
    "model": "risk-exposure",
    "explain": "An inspection protects production. While an item is overdue or deferred, the chance of a loss of containment rises; the cost of waiting is days at risk × added chance of failure ÷ 365 × shutdown days × site production × oil price. Trips cost a helicopter round trip each (shared by everyone on board) plus boat time for equipment.",
    "keys": [
      "INSP_POF_OVERDUE",
      "INSP_SHUTDOWN_D",
      "OIL_PRICE",
      "HELI_HOUR",
      "HELI_TRIP_H",
      "BOAT_DAY",
      "RATE_CONTR"
    ]
  },
  "history": [
    {
      "revision": "01",
      "date": "2024-01-01",
      "summary": "First modelled issue, drawn from ACE-AIM-PRA-001 and ACE-AIM-STD-002. Each offshore inspection booked as its own trip."
    },
    {
      "revision": "02",
      "date": "2025-06-01",
      "summary": "Campaign bundling: offshore inspections due within 60 days on the same platform are grouped into one trip, and site readiness is confirmed 48 hours before travel.",
      "ci": "CI-2024-001",
      "changed_steps": [
        "S06",
        "S08"
      ]
    }
  ],
