{
  "schema": "ONE-PRS/2",
  "id": "ACE-AIM-PRS-001",
  "revision": "02",
  "status": "Approved",
  "title": "Inspection Planning and Execution Process",
  "summary": "The repeating cycle that keeps equipment inspected on time: scope from the risk-based inspection plan, decide whether a deferral is needed, plan the work, move people and equipment to site, inspect, assess the results and set the next due date. Physical and cyclical: crews and equipment travel by helicopter and boat to the offshore platforms.",
  "character": "cyclical",
  "apqc": { "l1": "4 Maintain Assets", "l2": "4.2 Inspect and assess integrity", "l3": "Inspection Planning and Execution Process" },
  "owner": "Wayne Rajkumar — Inspection Lead",
  "function": "Operations",
  "policy": "ACE-LDR-POL-001",
  "commitments": ["ACE-LDR-POL-001#COM_ASSET_INTEGRITY", "ACE-LDR-POL-001#COM_TECHNICAL_AUTHORITY"],
  "policies_also": ["ACE-CON-POL-001", "ACE-RSK-POL-001"],
  "parent": "ACE-AIM-PRA-001",
  "oms_tags": ["6.5", "6.4"],
  "objectives": ["OBJ-26-03", "OBJ-26-09"],
  "ledger": "BPM-LOG-ACE-AIM-PRS-001",
  "case_label": "inspection",
  "cycle": { "name": "Inspection cycle", "from": "S13", "to": "S01", "label": "Next inspection falls due", "period": "Set by the RBI interval (12 to 48 months)" },
  "sipoc": {
    "suppliers": ["RBI plan", "Maintenance planning", "Logistics", "Inspection contractor"],
    "inputs": ["Inspection due list", "Previous results", "Written scheme of examination"],
    "process": ["Scope", "Decide", "Plan", "Mobilise", "Inspect", "Assess", "Reset due date"],
    "outputs": ["Inspection report", "Fitness-for-service decision", "Anomaly records", "Next due date"],
    "customers": ["Area Authority", "Technical Authority", "Anomaly Management Process", "Asset risk register"]
  },
  "lanes": [
    { "id": "L1", "role": "Inspection Lead", "role_id": "OPS-06", "function": "OPS" },
    { "id": "L2", "role": "Integrity Engineer", "role_id": "OPS-17", "function": "OPS" },
    { "id": "L3", "role": "Materials & Corrosion Lead (Technical Authority)", "role_id": "ENP-08", "function": "ENP", "oms_role": "TA" },
    { "id": "L4", "role": "Maintenance Planner", "role_id": "OPS-19", "function": "OPS" },
    { "id": "L5", "role": "Logistics Coordinator (Marine & Aviation)", "role_id": "SCM-11", "function": "SCM" },
    { "id": "L6", "role": "Offshore Installation Manager (Area Authority)", "role_id": "OPS-08", "function": "OPS", "oms_role": "AA" },
    { "id": "L7", "role": "Inspection contractor (NDT technicians)", "role_id": "", "function": "CTR", "external": true }
  ],
  "steps": [
    { "id": "S01", "lane": "L1", "type": "start", "name": "Inspection falls due", "next": ["S02"] },
    { "id": "S02", "lane": "L2", "type": "task", "name": "Review RBI and set scope", "value": "VA",
      "inputs": ["Inspection due list", "Previous results"], "outputs": ["Inspection scope"],
      "doc_refs": ["ACE-AIM-PRA-001#ACE_AIM_PRA_001_H004", "ACE-AIM-PRA-001#ACE_AIM_PRA_001_H005", "ACE-AIM-STD-002#ACE_AIM_STD_002_H604"],
      "controls": ["C-AIM-001", "C-AIM-002", "C-AIM-003"], "records": ["Inspection scope"], "systems": ["RBI software"],
      "sim": { "dur_h": [4, 8, 16], "wait_h": 24, "cost_role": "L2" }, "next": ["S03"] },
    { "id": "S03", "lane": "L1", "type": "xor", "name": "Can it be done by the due date?", "value": "BVA",
      "commitment": "ACE-LDR-POL-001#COM_ASSET_INTEGRITY",
      "sim": { "dur_h": [0.5, 1, 2], "cost_role": "L1" },
      "branches": [ { "to": "S05", "label": "On time", "p": 0.84 }, { "to": "S04", "label": "Needs deferral", "p": 0.16 } ] },
    { "id": "S04", "lane": "L3", "type": "task", "name": "Endorse deferral with safeguards", "value": "BVA",
      "inputs": ["Deferral request"], "outputs": ["Deferral record with expiry"],
      "doc_refs": ["ACE-AIM-PRA-001#ACE_AIM_PRA_001_H008", "ACE-AIM-STD-002#ACE_AIM_STD_002_H618"],
      "controls": ["C-AIM-004", "C-AIM-010"], "records": ["Deferral record"],
      "commitment": "ACE-LDR-POL-001#COM_TECHNICAL_AUTHORITY",
      "threshold": "Deferral periods by residual risk band (ACE-RSK-POL-001 section 4): 180, 90 or 30 days; one extension only",
      "sim": { "dur_h": [1, 2, 4], "wait_h": 72, "cost_role": "L3" }, "next": ["S05"] },
    { "id": "S05", "lane": "L4", "type": "task", "name": "Raise work order and work pack", "value": "BVA",
      "inputs": ["Inspection scope"], "outputs": ["Work order", "Work pack"],
      "doc_refs": ["ACE-MNT-PRA-001#ACE_MNT_PRA_001_H007"], "records": ["Work order"], "systems": ["CMMS"],
      "sim": { "dur_h": [1, 2, 4], "wait_h": 48, "cost_role": "L4" }, "next": ["S06"] },
    { "id": "S06", "lane": "L5", "type": "task", "name": "Book transport and manifest crew", "value": "BVA",
      "inputs": ["Work order"], "outputs": ["Flight or boat booking", "Manifest"],
      "doc_refs": ["ACE-AIM-STD-002#ACE_AIM_STD_002_H616"], "records": ["Manifest"], "systems": ["Logistics booking"],
      "commitment": "ACE-CON-POL-001#COM_PEOPLE_MOVEMENT",
      "sim": { "dur_h": [0.5, 1, 2], "wait_h": 120, "cost_role": "L5" }, "next": ["S07"] },
    { "id": "S07", "lane": "L6", "type": "task", "name": "Issue permit and prepare site", "value": "BVA",
      "inputs": ["Work pack"], "outputs": ["Permit to work"],
      "doc_refs": ["ACE-COW-PRC-001#ACE_COW_PRC_001_H004", "ACE-COW-PRC-001#ACE_COW_PRC_001_H005"],
      "controls": ["C-COW-001", "C-COW-004"], "records": ["Permit to work"], "systems": ["Permit system"],
      "sim": { "dur_h": [1, 2, 4], "cost_role": "L6" }, "next": ["S08"] },
    { "id": "S08", "lane": "L6", "type": "xor", "name": "Site ready on arrival?", "value": "NVA",
      "branches": [ { "to": "S09", "label": "Ready", "p": 0.9 }, { "to": "S06", "label": "Weather or permit not ready", "p": 0.1, "loop": "rework" } ] },
    { "id": "S09", "lane": "L7", "type": "task", "name": "Perform inspection", "value": "VA",
      "inputs": ["Permit to work", "NDT equipment"], "outputs": ["Raw inspection data"],
      "doc_refs": ["ACE-AIM-STD-002#ACE_AIM_STD_002_H605", "ACE-AIM-STD-002#ACE_AIM_STD_002_H613"],
      "records": ["Raw inspection data"],
      "sim": { "dur_h": [4, 8, 24], "cost_role": "L7" }, "next": ["S10"] },
    { "id": "S10", "lane": "L7", "type": "task", "name": "Report findings", "value": "VA",
      "inputs": ["Raw inspection data"], "outputs": ["Inspection report"],
      "doc_refs": ["ACE-AIM-STD-002#ACE_AIM_STD_002_H612"], "controls": ["C-AIM-008"],
      "records": ["Inspection report"], "systems": ["Inspection data system"],
      "sim": { "dur_h": [2, 4, 8], "wait_h": 72, "cost_role": "L7" }, "next": ["S11"] },
    { "id": "S11", "lane": "L2", "type": "xor", "name": "Assess fitness for service", "value": "VA",
      "doc_refs": ["ACE-AIM-PRA-001#ACE_AIM_PRA_001_H008", "ACE-AIM-STD-002#ACE_AIM_STD_002_H609"],
      "sim": { "dur_h": [2, 4, 12], "cost_role": "L2" },
      "branches": [ { "to": "S13", "label": "Acceptable", "p": 0.86 }, { "to": "S12", "label": "Anomaly found", "p": 0.14 } ] },
    { "id": "S12", "lane": "L3", "type": "task", "name": "Raise anomaly and set safeguards", "value": "VA",
      "inputs": ["Inspection report"], "outputs": ["Anomaly record"],
      "doc_refs": ["ACE-AIM-STD-002#ACE_AIM_STD_002_H614"], "controls": ["C-AIM-007", "C-AIM-010"],
      "records": ["Anomaly record"], "systems": ["Inspection data system"],
      "sim": { "dur_h": [2, 4, 8], "cost_role": "L3" }, "next": ["S13"] },
    { "id": "S13", "lane": "L1", "type": "task", "name": "Update RBI and set next due date", "value": "VA",
      "inputs": ["Inspection report", "Anomaly record"], "outputs": ["Updated RBI", "Next due date"],
      "doc_refs": ["ACE-AIM-PRA-001#ACE_AIM_PRA_001_H005", "ACE-AIM-PRA-001#ACE_AIM_PRA_001_H009"],
      "controls": ["C-AIM-009"], "records": ["Updated RBI"], "systems": ["RBI software"],
      "sim": { "dur_h": [1, 2, 4], "wait_h": 48, "cost_role": "L1" }, "next": ["S14"] },
    { "id": "S14", "lane": "L1", "type": "end", "name": "Inspection cycle closed" }
  ],
  "flows": [
    { "from": "S02", "to": "S05", "type": "information", "carries": "Inspection scope" },
    { "from": "S06", "to": "S09", "type": "people", "carries": "NDT crew by helicopter to the platform" },
    { "from": "S06", "to": "S09", "type": "material", "carries": "NDT equipment by supply boat from Point Lisas" },
    { "from": "S10", "to": "S06", "type": "people", "carries": "Crew back to shore" },
    { "from": "S10", "to": "S11", "type": "information", "carries": "Inspection report and thickness data" },
    { "from": "S12", "to": "ACE-AIM-PRS-002", "type": "information", "carries": "Anomaly to the Anomaly Management Process" },
    { "from": "S13", "to": "S02", "type": "information", "carries": "Updated RBI and history for the next cycle" }
  ],
  "kpis": [
    { "name": "Days from due notice to closed cycle (median)", "family": "cycle time", "type": "lagging", "measure": "cycle_median_days", "target": "≤ 45 days", "threshold": 45, "better": "down" },
    { "name": "Inspections done by the original due date", "family": "quality", "type": "leading", "measure": "on_time", "target": "≥ 90%", "threshold": 90, "better": "up" },
    { "name": "Controls in the process that are effective", "family": "control effectiveness", "type": "leading", "measure": "control_health", "target": "100%", "threshold": 100, "better": "up" },
    { "name": "Cases that followed the modelled path", "family": "conformance", "type": "lagging", "measure": "conformance", "target": "≥ 90%", "threshold": 90, "better": "up" },
    { "name": "Inspections needing a deferral", "family": "other", "type": "leading", "measure": "deferral_rate", "target": "≤ 10%", "threshold": 10, "better": "down" }
  ],
  "value": {
    "model": "risk-exposure",
    "explain": "An inspection protects production. While an item is overdue or deferred, the chance of a loss of containment rises; the cost of waiting is days at risk × added chance of failure ÷ 365 × shutdown days × site production × oil price. Trips cost a helicopter round trip each (shared by everyone on board) plus boat time for equipment.",
    "keys": ["INSP_POF_OVERDUE", "INSP_SHUTDOWN_D", "OIL_PRICE", "HELI_HOUR", "HELI_TRIP_H", "BOAT_DAY", "RATE_CONTR"]
  },
  "history": [
    { "revision": "01", "date": "2024-01-01", "summary": "First modelled issue, drawn from ACE-AIM-PRA-001 and ACE-AIM-STD-002. Each offshore inspection booked as its own trip." },
    { "revision": "02", "date": "2025-06-01", "summary": "Campaign bundling: offshore inspections due within 60 days on the same platform are grouped into one trip, and site readiness is confirmed 48 hours before travel.", "ci": "CI-2024-001", "changed_steps": ["S06", "S08"] }
  ],
  "sim_defaults": { "volume_per_year": 150, "rates_per_h": { "L1": 42, "L2": 21, "L3": 42, "L4": 21, "L5": 21, "L6": 42, "L7": 85 } }
}
